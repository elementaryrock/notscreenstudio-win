{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window and HUD overlay capabilities for notscreenstudio.",
  "windows": [
    "main",
    "hud-setup",
    "hud-recording",
    "hud-countdown",
    "hud-area",
    "hud-camera-bubble"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "core:event:default"
  ]
}
